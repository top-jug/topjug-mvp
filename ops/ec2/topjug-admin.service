[Unit]
Description=TopJug operations console application
After=network-online.target topjug-web.service
Wants=network-online.target

[Service]
Type=simple
User=topjug
Group=topjug
WorkingDirectory=/opt/topjug/current/apps/admin
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3001
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
