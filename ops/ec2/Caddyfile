topjug.kr {
	encode zstd gzip

	@operationsUi path /ops /ops/*
	redir @operationsUi https://ops.topjug.kr{uri} 308

	@operationsApi path /api/v1/ops /api/v1/ops/*
	respond @operationsApi 404

	@mediaUpload {
		method POST
		path /api/v1/ops/media/images /api/v1/ops/gyms/*/media
	}
	request_body @mediaUpload {
		max_size 11MB
	}

	@standardBody not path /api/v1/ops/media/images /api/v1/ops/gyms/*/media
	request_body @standardBody {
		max_size 64KB
	}

	@ready path /api/ready
	respond @ready 404
	reverse_proxy 127.0.0.1:3000

	header {
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

ops.topjug.kr {
	encode zstd gzip

	@mediaUpload {
		method POST
		path /api/v1/ops/media/images /api/v1/ops/gyms/*/media
	}
	request_body @mediaUpload {
		max_size 11MB
	}

	@standardBody not path /api/v1/ops/media/images /api/v1/ops/gyms/*/media
	request_body @standardBody {
		max_size 64KB
	}

	@adminApi path /api/v1/auth/login /api/v1/auth/logout /api/v1/auth/refresh /api/v1/me /api/v1/ops/*
	handle @adminApi {
		reverse_proxy 127.0.0.1:3000
	}

	handle /api/* {
		respond 404
	}

	handle {
		reverse_proxy 127.0.0.1:3001
	}

	header {
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "noindex, nofollow, noarchive"
	}
}
