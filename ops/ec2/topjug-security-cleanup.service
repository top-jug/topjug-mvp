[Unit]
Description=TopJug security data retention cleanup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=topjug
Group=topjug
WorkingDirectory=/opt/topjug/current
Environment=APP_PROFILE=production
Environment=AWS_REGION=ap-northeast-2
Environment=SSM_PARAMETER_PREFIX=/topjug/prod
ExecStart=/usr/bin/node /opt/topjug/current/.migration/cleanup-security-data.cjs
NoNewPrivileges=true
PrivateTmp=true
