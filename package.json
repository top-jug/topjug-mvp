{
  "name": "topjug-mvp",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "next build",
    "build:migrate": "esbuild scripts/migrate.mjs scripts/cleanup-security-data.mjs scripts/import-initial-gyms.ts scripts/provision-runtime-db-role.mjs --bundle --platform=node --format=cjs --target=node20 --outdir=.migration --out-extension:.js=.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:local": "node --env-file=.env.local scripts/migrate.mjs",
    "db:import:gyms:check": "tsx scripts/import-initial-gyms.ts --dry-run",
    "db:import:gyms": "node --import tsx scripts/import-initial-gyms.ts",
    "db:import:gyms:local": "node --env-file=.env.local --import tsx scripts/import-initial-gyms.ts --apply",
    "dev": "next dev",
    "dev:local": "next dev",
    "local:down": "docker compose down",
    "local:up": "docker compose up --detach --wait",
    "start": "next start",
    "test": "tsx --conditions=react-server --test tests/**/*.unit.test.ts",
    "test:integration": "tsx --conditions=react-server --test tests/**/*.integration.test.ts",
    "test:integration:local": "node --env-file=.env.local --conditions=react-server --import tsx --test tests/**/*.integration.test.ts",
    "test:http": "node scripts/test-http-local.mjs",
    "test:http:local": "node --env-file=.env.local scripts/test-http-local.mjs",
    "typecheck": "tsc --noEmit"
  },
